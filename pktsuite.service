[Unit]
Description=pktSuite NOC/SOC Management Hub
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/mnt/software/pktsuite
ExecStart=/mnt/software/pktsuite/venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8760 --ssl-certfile /etc/ssl/pktsuite/cert.pem --ssl-keyfile /etc/ssl/pktsuite/key.pem
Restart=always
RestartSec=5
StandardOutput=append:/mnt/software/logs/pktsuite.log
StandardError=append:/mnt/software/logs/pktsuite.log

[Install]
WantedBy=multi-user.target
