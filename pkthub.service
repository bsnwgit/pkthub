[Unit]
Description=pktHub NOC/SOC Management Hub
After=network.target

[Service]
Type=simple
User=__INSTALL_USER__
WorkingDirectory=__INSTALL_DIR__
Environment=PKTHUB_INSTALL_DIR=__INSTALL_DIR__
Environment=PKTSUITE_CONFIG=__INSTALL_DIR__/config.yaml
# HTTP by default. To enable HTTPS: upload a cert via Settings > SSL, then add
# --ssl-certfile /etc/ssl/pkthub/cert.pem --ssl-keyfile /etc/ssl/pkthub/key.pem
# below and run: systemctl daemon-reload && systemctl restart pkthub
ExecStart=__INSTALL_DIR__/venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8760
Restart=always
RestartSec=5
StandardOutput=append:__INSTALL_DIR__/logs/pkthub.log
StandardError=append:__INSTALL_DIR__/logs/pkthub.log

[Install]
WantedBy=multi-user.target
