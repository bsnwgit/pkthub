[Unit]
Description=pktHub NOC/SOC Management Hub
After=network.target

[Service]
Type=simple
# Substitute __INSTALL_DIR__ (default: /opt/pkthub) and __SERVICE_USER__
# for your target values before installing (no install script templates
# this file automatically — see DEPLOYMENT.md).
User=__SERVICE_USER__
WorkingDirectory=__INSTALL_DIR__
Environment=PKTSUITE_CONFIG=__INSTALL_DIR__/config.yaml
ExecStart=__INSTALL_DIR__/venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8760 --ssl-certfile /etc/ssl/pkthub/cert.pem --ssl-keyfile /etc/ssl/pkthub/key.pem
Restart=always
RestartSec=5
StandardOutput=append:__INSTALL_DIR__/logs/pkthub.log
StandardError=append:__INSTALL_DIR__/logs/pkthub.log

[Install]
WantedBy=multi-user.target
