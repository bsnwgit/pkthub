[Unit]
Description=pktDashboard — pktsuite landing page
After=network.target

[Service]
Type=simple
# Substitute __INSTALL_DIR__ (default: /opt/pktdashboard) and __SERVICE_USER__
# for your target values before installing (no install script templates
# this file automatically — see DEPLOYMENT.md).
User=__SERVICE_USER__
Group=__SERVICE_USER__
WorkingDirectory=__INSTALL_DIR__

Environment=PYTHONUNBUFFERED=1

ExecStart=__INSTALL_DIR__/venv/bin/python3 -m app.main

Restart=always
RestartSec=5
StartLimitInterval=60
StartLimitBurst=3

StandardOutput=append:/var/log/pktdashboard/pktdashboard.log
StandardError=append:/var/log/pktdashboard/pktdashboard.log

NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
