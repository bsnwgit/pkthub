[Unit]
Description=pktHub NOC/SOC Management Hub
After=network.target

[Service]
Type=simple
User=appuser
WorkingDirectory=/opt/pkthub
Environment=PKTSUITE_CONFIG=/opt/pkthub/config.yaml
ExecStart=/opt/pkthub/venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8760 --ssl-certfile /etc/ssl/pkthub/cert.pem --ssl-keyfile /etc/ssl/pkthub/key.pem
Restart=always
RestartSec=5
StandardOutput=append:/opt/pkthub/logs/pkthub.log
StandardError=append:/opt/pkthub/logs/pkthub.log

[Install]
WantedBy=multi-user.target
